direction: right
classes: {
  https: {
    style: {
      font-color: black
      stroke-width: 3
      stroke: black
    }
  }
  https+signature: {
    style: {
      font-color: green
      stroke-width: 3
      stroke: green
    }
  }
  https+signature+provenance: {
    style: {
      font-color: blue
      stroke-width: 3
      stroke: blue
    }
  }
}
vars: {
  d2-config: {
    layout-engine: elk
    # Terminal theme code
    # theme-id: 300
    # sketch: true
  }
  d2-legend: {
    a -> b: HTTPS + Signature Verification + Provenance Verification {
      class: https+signature+provenance
    }
    a -> b: HTTPS + Signature Verification {
      class: https+signature
    }
    a -> b: HTTPS {
      class: https
    }
    a.style.opacity: 0
    b.style.opacity: 0
  }
}

# **.style.font-size: 35
# This is a workaround due to a bug with globs: https://github.com/terrastruct/d2/issues/2709
*.style.font-size: 35
*.*.style.font-size: 35
*.*.*.style.font-size: 35
*.*.*.*.style.font-size: 35
*.*.*.*.*.style.font-size: 35

(** -> **)[*].style.font-size: 30

Secureblue Build: {
  Secureblue GitHub-Hosted Runner: {
    icon: ./assets/github.svg
    StepSecurity Harden-Runner (Egress Auditor): {
      icon: ./assets/stepsecurity.jpeg
      Build Job: {
        Blue-Build CLI: {
          icon: ./assets/bluebuild.png
        }
      }

      Provenance Job: {
        SLSA generator: {
          icon: ./assets/slsa.png
        }
      }
    }

    StepSecurity Harden-Runner (Egress Auditor).Provenance Job.SLSA Generator -> StepSecurity Harden-Runner (Egress Auditor).Build Job: attestation generation {
      class: https
    }
  }
}

Trivalent Build: {
  Secureblue GitHub-Hosted Runner: {
    icon: ./assets/github.svg
    StepSecurity Harden-Runner (Egress Auditor): {
      icon: ./assets/stepsecurity.jpeg

      SRPM Build Job

      Signing Job

      Provenance Job: {
        SLSA Generator: {
          icon: ./assets/slsa.png
        }
      }
    }

    StepSecurity Harden-Runner (Egress Auditor).Provenance Job.SLSA generator -> StepSecurity Harden-Runner (Egress Auditor).Signing Job: attestation generation {
      class: https
    }
    StepSecurity Harden-Runner (Egress Auditor).Provenance Job.SLSA generator -> StepSecurity Harden-Runner (Egress Auditor).SRPM Build Job: attestation generation {
      class: https
    }
  }

  Secureblue AWS-Hosted Runner via Runs-On: {
    icon: ./assets/runson.png
    StepSecurity Harden-Runner (Egress Auditor): {
      icon: ./assets/stepsecurity.jpeg

      RPM Build Job
    }
  }
}

Secureblue Copr Runners: {
  icon: ./assets/copr.png

  Build for bubblejail

  Build for hardened_malloc

  Build for run0edit

  Build for branding

  Build for Trivalent source cache

  Build for Trivalent subresource filter
}

Secureblue Copr Runners -> Fedora Copr: push build {
  class: https
}

Secureblue Copr Runners -> Secureblue Github Repos: pull source {
  class: https
}

GitHub Container Registry: {
  icon: ./assets/githubcontainerregistry.png
}

User Machine: {
  shape: image
  icon: ./assets/securebluelaptop.png
}

Secureblue RPM Repo: {
  shape: image
  icon: ./assets/secureblue.svg
}

Fedora Copr: {
  shape: image
  icon: ./assets/copr.png
}

Negativo17

Fedora Repos: {
  shape: image
  icon: ./assets/fedora.png
}

Fedora Quay Registry: {
  shape: image
  icon: ./assets/quay.png
}

Secureblue GitHub Repos: {
  shape: image
  icon: ./assets/github.svg
}

User Machine -> Github Container Registry: update pull {
  class: https+signature+provenance
}

Secureblue Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Provenance Job.SLSA Generator -> GitHub Container Registry: attestation push {
  class: https
}
Secureblue Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Build Job.Blue-Build CLI -> GitHub Container Registry: image and signature push {
  class: https
}
Secureblue Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Build Job.Blue-Build CLI -> Fedora Repos: install packages {
  class: https+signature
}
Secureblue Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Build Job.Blue-Build CLI -> Negativo17: install packages {
  class: https+signature
}
Secureblue Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Build Job.Blue-Build CLI -> Fedora Copr: install packages {
  class: https+signature
}
Secureblue Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Build Job.Blue-Build CLI -> Fedora Quay Registry: pull base image {
  class: https+signature
}
Trivalent Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Provenance Job.SLSA Generator -> Trivalent Build.Secureblue AWS-Hosted Runner via Runs-On.StepSecurity Harden-Runner (Egress Auditor).RPM Build Job: attestation generation {
  class: https
}
Trivalent Build.Secureblue AWS-Hosted Runner via Runs-On.StepSecurity Harden-Runner (Egress Auditor).RPM Build Job -> Trivalent Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).SRPM Build Job: pull srpm {
  class: https
}
Trivalent Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Signing Job -> Trivalent Build.Secureblue AWS-Hosted Runner via Runs-On.StepSecurity Harden-Runner (Egress Auditor).RPM Build Job: pull rpm {
  class: https
}
Trivalent Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Signing Job -> Secureblue RPM Repo: push signed rpm {
  class: https
}
Secureblue Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Build Job.Blue-Build CLI -> Secureblue RPM Repo: install trivalent rpm {
  class: https+signature+provenance
}
Secureblue Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Build Job.Blue-Build CLI -> Secureblue Github Repos: pull trivalent attestation {
  class: https
}
Trivalent Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).SRPM Build Job -> Fedora Copr: pull source cache {
  class: https+signature
}
Trivalent Build.Secureblue GitHub-Hosted Runner.StepSecurity Harden-Runner (Egress Auditor).Provenance Job.SLSA Generator -> Secureblue GitHub Repos: push attestation {
  class: https
}
Secureblue Build.Secureblue GitHub-Hosted Runner -> GitHub Container Registry: install blue-build cli {
  class: https+signature+provenance
}
